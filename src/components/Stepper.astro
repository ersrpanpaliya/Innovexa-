---
import Icons from './Icons.astro';
---

<nav class="stepper-nav" aria-label="Application Progress Stepper">
  <div class="container stepper-container">
    <div class="stepper-track" aria-hidden="true">
      <div class="stepper-progress-fill" id="stepper-progress-fill"></div>
    </div>

    <ol class="stepper-list">
      <!-- Step 1: Sign In -->
      <li class="step-item active" data-step="1">
        <button type="button" class="step-btn" aria-current="step">
          <span class="step-bubble">
            <span class="step-num tabular-nums">1</span>
            <span class="step-check" aria-hidden="true"><Icons name="check" size={14} /></span>
          </span>
          <span class="step-label" data-i18n="step_1_title">Sign In</span>
        </button>
      </li>

      <!-- Step 2: Profile -->
      <li class="step-item" data-step="2">
        <button type="button" class="step-btn">
          <span class="step-bubble">
            <span class="step-num tabular-nums">2</span>
            <span class="step-check" aria-hidden="true"><Icons name="check" size={14} /></span>
          </span>
          <span class="step-label" data-i18n="step_2_title">Profile</span>
        </button>
      </li>

      <!-- Step 3: Entitlement -->
      <li class="step-item" data-step="3">
        <button type="button" class="step-btn">
          <span class="step-bubble">
            <span class="step-num tabular-nums">3</span>
            <span class="step-check" aria-hidden="true"><Icons name="check" size={14} /></span>
          </span>
          <span class="step-label" data-i18n="step_3_title">Entitlement</span>
        </button>
      </li>

      <!-- Step 4: Records -->
      <li class="step-item" data-step="4">
        <button type="button" class="step-btn">
          <span class="step-bubble">
            <span class="step-num tabular-nums">4</span>
            <span class="step-check" aria-hidden="true"><Icons name="check" size={14} /></span>
          </span>
          <span class="step-label" data-i18n="step_4_title">Records</span>
        </button>
      </li>

      <!-- Step 5: Report -->
      <li class="step-item" data-step="5">
        <button type="button" class="step-btn">
          <span class="step-bubble">
            <span class="step-num tabular-nums">5</span>
            <span class="step-check" aria-hidden="true"><Icons name="check" size={14} /></span>
          </span>
          <span class="step-label" data-i18n="step_5_title">Report</span>
        </button>
      </li>
    </ol>
  </div>
</nav>

<style>
  .stepper-nav {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 1.25rem 0;
    position: relative;
    user-select: none;
  }

  .stepper-container {
    position: relative;
  }

  .stepper-track {
    position: absolute;
    top: 20px;
    left: 40px;
    right: 40px;
    height: 3px;
    background-color: var(--color-border);
    z-index: 1;
  }

  .stepper-progress-fill {
    height: 100%;
    width: 0%;
    background-color: var(--color-primary);
    transition: width var(--duration-medium) var(--ease-out);
  }

  .stepper-list {
    display: flex;
    justify-content: space-between;
    list-style: none;
    position: relative;
    z-index: 2;
    margin: 0;
    padding: 0;
  }

  .step-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .step-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    font-family: inherit;
  }

  .step-bubble {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    color: var(--color-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
    transition: border-color var(--duration-fast) var(--ease-out),
                background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
    position: relative;
  }

  .step-check {
    display: none;
  }

  .step-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted);
    transition: color var(--duration-fast) var(--ease-out);
    white-space: nowrap;
  }

  /* Active State */
  .step-item.active .step-bubble {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: #FFFFFF;
    box-shadow: 0 0 0 4px var(--color-primary-subtle);
    transform: scale(1.08);
  }

  [data-theme="dark"] .step-item.active .step-bubble {
    color: #0A1122;
  }

  .step-item.active .step-label {
    color: var(--color-primary);
    font-weight: 700;
  }

  /* Completed State */
  .step-item.completed .step-bubble {
    border-color: var(--color-success);
    background-color: var(--color-success);
    color: #FFFFFF;
  }

  .step-item.completed .step-num {
    display: none;
  }

  .step-item.completed .step-check {
    display: flex;
  }

  .step-item.completed .step-label {
    color: var(--color-text);
  }

  @media (max-width: 600px) {
    .step-track {
      left: 20px;
      right: 20px;
    }
    .step-bubble {
      width: 32px;
      height: 32px;
      font-size: 0.75rem;
    }
    .step-label {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 420px) {
    .step-label {
      display: none;
    }
  }
</style>
