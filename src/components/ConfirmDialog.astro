---
import Icons from './Icons.astro';
---

<dialog id="reset-dialog" class="gov-dialog" aria-labelledby="dialog-title" aria-describedby="dialog-desc">
  <div class="dialog-inner">
    <div class="dialog-icon text-warning">
      <Icons name="alert" size={32} />
    </div>

    <h3 id="dialog-title" class="dialog-title" data-i18n="dialog_reset_title">
      Start a New Report?
    </h3>

    <p id="dialog-desc" class="dialog-description" data-i18n="dialog_reset_desc">
      This will clear recorded delivery items and reset the current report state. User profile details will be preserved.
    </p>

    <div class="dialog-actions">
      <button type="button" id="btn-cancel-reset" class="btn btn-secondary">
        <span data-i18n="dialog_reset_cancel">Cancel</span>
      </button>
      <button type="button" id="btn-confirm-reset" class="btn btn-primary">
        <span data-i18n="dialog_reset_confirm">Yes, Start New</span>
      </button>
    </div>
  </div>
</dialog>

<style>
  .gov-dialog {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    color: var(--color-text);
    padding: 0;
    max-width: 480px;
    width: 90%;
    box-shadow: var(--shadow-xl);
    margin: auto;
  }

  .gov-dialog::backdrop {
    background-color: rgba(11, 27, 51, 0.6);
    backdrop-filter: blur(4px);
  }

  .dialog-inner {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .dialog-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: var(--color-warning-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dialog-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .dialog-description {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .dialog-actions {
    display: flex;
    gap: 1rem;
    width: 100%;
    margin-top: 1rem;
  }

  .dialog-actions .btn {
    flex: 1;
  }
</style>
